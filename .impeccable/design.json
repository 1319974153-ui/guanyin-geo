  "components": [
    {
      "name": "检测 AI 平台",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "真实按钮变体；颜色来自当前主题语义 token。",
      "html": "<button class=\"ds-button-primary\">检测 AI 平台</button>",
      "css": ".ds-button-primary{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:10px 16px;border:1px solid var(--accent,#a6e8ed);border-radius:8px;background:var(--accent,#a6e8ed);color:var(--primary-ink,#09202a);font-weight:650;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease;}.ds-button-primary:hover,.ds-button-primary:active{background:var(--accent-hover,#d0f7f8);}.ds-button-primary:focus-visible{outline:2px solid var(--focus-edge,#b5f2f4);outline-offset:4px}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "查看详情",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "真实按钮变体；颜色来自当前主题语义 token。",
      "html": "<button class=\"ds-button-secondary\">查看详情</button>",
      "css": ".ds-button-secondary{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:10px 16px;border:1px solid var(--control-line,#60778d);border-radius:8px;background:var(--surface-raised,#17212d);color:var(--ink,#eef4fc);font-weight:500;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease;}.ds-button-secondary:hover,.ds-button-secondary:active{background:var(--hover,#233541);}.ds-button-secondary:focus-visible{outline:2px solid var(--focus-edge,#b5f2f4);outline-offset:4px}.ds-button-secondary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "更多操作",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "真实按钮变体；颜色来自当前主题语义 token。",
      "html": "<button class=\"ds-button-ghost\">更多操作</button>",
      "css": ".ds-button-ghost{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:10px 16px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted,#9cabbe);font-weight:500;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease;}.ds-button-ghost:hover,.ds-button-ghost:active{background:var(--surface-raised,#17212d);}.ds-button-ghost:focus-visible{outline:2px solid var(--focus-edge,#b5f2f4);outline-offset:4px}.ds-button-ghost:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "业务名称输入",
      "kind": "input",
      "refersTo": "input",
      "description": "输入样式与键盘焦点预览。",
      "html": "<label class=\"ds-field\">业务名称<input class=\"ds-input\" placeholder=\"填写业务名称\"></label>",
      "css": ".ds-field{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;display:grid;gap:7px;color:var(--ink,#eef4fc)}.ds-input{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;padding:9px 12px;border:1px solid var(--control-line,#60778d);border-radius:7px;background:var(--sidebar,#0b1017);color:var(--ink,#eef4fc)}.ds-input::placeholder{color:var(--muted,#9cabbe)}.ds-input:hover{border-color:var(--accent,#a6e8ed)}.ds-input:focus-visible{outline:2px solid var(--focus-edge,#b5f2f4);outline-offset:4px}"
    },
    {
      "name": "主导航",
