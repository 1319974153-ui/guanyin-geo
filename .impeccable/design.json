      "html": "<div role=\"tablist\" aria-label=\"AI 平台\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">豆包</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">腾讯元宝</button></div>",
      "css": ".ds-tab{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;font-size:12px;min-height:40px;padding:9px 12px;border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted,#9cabbe);cursor:pointer}.ds-tab:hover{background:var(--surface-raised,#17212d);color:var(--ink,#eef4fc)}.ds-tab[aria-selected=\"true\"]{background:var(--pale,#193139);color:var(--accent,#a6e8ed);border-color:var(--selected-line,#456c78)}.ds-tab:focus-visible{outline:2px solid var(--focus-edge,#b5f2f4);outline-offset:4px}"
    },
    {
      "name": "内容卡片",
      "kind": "card",
      "refersTo": "card",
      "description": "安静的内容容器，无虚构指标。",
      "html": "<section class=\"ds-card\"><h3>待我确认</h3><p>根据实际业务记录显示待确认事项。</p></section>",
      "css": ".ds-card{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:13px;padding:22px;border:1px solid var(--line,#273443);border-radius:12px;background:var(--surface,#101720);color:var(--ink,#eef4fc)}.ds-card h3{margin:0 0 14px;font-size:16px;font-weight:550}.ds-card p{margin:0;font-size:13px;line-height:1.75;color:var(--muted,#9cabbe)}"
    }
  ],
  "narrative": {
    "northStar": "黑曜折光",
    "overview": "黑曜石底色、冷白文字与局部青蓝折射形成安静而精致的操作环境。光感集中在主行动区域；内容、表单和真实证据依靠稳定的语义色与清晰字阶承载。\n\n默认深色，保留浅色外观。界面采用离线可用的系统中文字体与原生 HTML/CSS/JavaScript；Canvas 光带为本项目原生实现。Paper Shaders 与 Motion Primitives 仅为设计参考，未集成其源码或运行时。",
    "keyCharacteristics": [
      "深色为默认，浅色共享同一组语义角色。",
      "局部折光与指针响应常开，无光效开关或光效偏好。",
      "系统字体、细边框、分层表面与克制的圆角。",
      "状态与操作保留可读文字，视觉光感不代表业务成功。"
    ],
    "rules": [
      {
        "name": "Evidence Before Light",
        "body": "光只承担材质与焦点表达，不能替代真实采样、发布回执或成功状态。",
        "section": "colors"
      },
      {
        "name": "Local Light",
        "body": "折光限定在主行动区域，正文、表单和证据保持稳定；系统减少动态效果时使用静态画面。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用共享语义色同步覆盖深色、浅色、表单、抽屉与三个简单模式入口。",
      "Do 保留清晰焦点、真实状态文字和键盘可操作的平台标签。",
      "Do 保留离线系统字体与本地静态资源。",
      "Do 以系统减少动态效果和离屏暂停适配动态光感。"
    ],
    "donts": [
      "Don't 添加光效开关、光效偏好或与视觉修改绑定的自动发布权限。",
      "Don't 将装饰光、选中态或零样本解释为采样成功、AI 收录或增长结果。",
      "Don't 声称集成仅用于视觉参考的第三方库。"
    ]
  }
}
