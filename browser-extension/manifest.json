{
  "manifest_version": 3,
  "name": "观引发布连接器（验收版）",
  "version": "0.2.5",
  "description": "观引自有多平台发布连接器：CSDN、头条、知乎、抖音图文、小红书图文。逐平台验收，按需授权。",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://mp.csdn.net/*",
    "https://mp.toutiao.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://www.zhihu.com/*",
    "https://creator.douyin.com/*",
    "https://creator.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
